rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidRegistration(data) {
      return data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.passOrTier is string && data.passOrTier.size() > 0 && data.passOrTier.size() <= 100
        && data.status is string;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Registrations Collection - universally available across devices
    match /registrations/{registrationId} {
      allow create: if isValidId(registrationId)
        && isValidRegistration(incoming());

      allow get, list: if true;

      allow update: if isValidId(registrationId)
        && isValidRegistration(incoming());

      allow delete: if isValidId(registrationId);
    }

    // Tickets Collection
    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    // Counters Collection
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
