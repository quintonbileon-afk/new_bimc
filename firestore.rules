rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Registrations collection:
    // Allows public registrations and full Secretariat admin visibility across devices
    match /registrations/{registrationId} {
      allow read, write: if true;
    }

    // 2. Delegate & Attendee Tickets:
    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    // 3. Ticket sequence counters:
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // 4. Communique newsletter subscribers:
    match /communique_subscribers/{subscriberId} {
      allow read, write: if true;
    }

    // 5. Connectivity health check:
    match /test/{docId} {
      allow read, write: if true;
    }

    // 6. Catch-all:
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
